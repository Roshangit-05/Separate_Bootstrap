# Flask Client Application Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5001
SECRET_KEY=super-secret-client-session-key-replace-in-production-459201

# Production or Local Backend API Base URL
# Local development:
API_BASE_URL=http://127.0.0.1:5000

# Production (when deployed to Render):
# API_BASE_URL=https://your-api.onrender.com

# HTTP Client Timeout in Seconds (handles Render spin-up cold starts)
API_TIMEOUT=15
