# Flask Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Security Keys (Change these in production!)
SECRET_KEY=super-secret-flask-key-replace-in-production-673892
JWT_SECRET_KEY=jwt-secret-token-key-replace-in-production-904123
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Database
# Local SQLite file database
DATABASE_URL=sqlite:///tasks_notes.db

# CORS Configuration (Comma-separated allowed origins, or * for all)
CORS_ORIGINS=http://localhost:3000,http://localhost:5001,https://your-client-app.onrender.com
